{
  "name": "@c0upons/cli",
  "version": "1.2.0",
  "description": "c0upons CLI — search, submit, and manage coupons from the terminal",
  "type": "module",
  "bin": {
    "c0upons": "./dist/index.js"
  },
  "scripts": {
