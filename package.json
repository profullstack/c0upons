{
  "name": "c0upons",
  "version": "1.9.3",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@c0upons/web",
    "dev:cli": "turbo run dev --filter=@c0upons/cli",
    "build": "turbo run build",
    "start": "bun --filter @c0upons/web start",
    "build:web": "turbo run build --filter=@c0upons/web",
    "build:cli": "turbo run build --filter=@c0upons/cli",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "test": "bun test test && turbo run test",
    "setup:hooks": "git config core.hooksPath .githooks && echo 'Git hooks configured'"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/profullstack/c0upons.git"
  },
  "author": "Profullstack, Inc.",
  "license": "MIT",
  "workspaces": [
    "apps/*"
  ],
  "overrides": {
    "js-yaml": "^4.3.2",
    "browserslist": "^4.29.4",
    "zod": "^4.6.7",
    "baseline-browser-mapping": "^2.11.33"
  }
}
