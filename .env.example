# Postgres in production (the client is @profullstack/libsql-pg). Turso is no
# longer read: the data was copied to Postgres with `npx libsql-pg copy` (2026-09).
DATABASE_URL=postgres://localhost:5432/c0upons   # add user:password@ before the host as needed
# For local development, point at a file instead:
# DATABASE_URL=file:./local.db
NEXT_PUBLIC_BASE_URL=https://c0upons.com
COINPAY_API_KEY=cp_live_your_api_key
COINPAY_CLIENT_ID=cp_live_your_api_key
COINPAY_MERCHANT_ID=your-merchant-uuid
COINPAY_CLIENT_SECRET=your-coinpay-client-secret
SESSION_SECRET=your-session-secret
COINPAY_WEBHOOK_SECRET=whsecret_your_webhook_secret
CRAWLPROOF_WEBHOOK_SECRET=your-crawlproof-webhook-secret

# Crawl gateway (@profullstack/x402-gateway): AI training crawlers pay $1/day over
# x402. A SCOPED CoinPay key (payments:create) and the EVM address that receives
# the USDC. Unset = crawlers still get 402, nothing sold.
COINPAY_X402_KEY=
CRAWL_PAY_TO=
